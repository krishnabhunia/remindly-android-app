<Window x:Class="Remindly.App.Views.MapPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Style="{StaticResource Window.Dialog}" WindowStartupLocation="CenterOwner"
        Title="Pick the shop on the map" Width="900" Height="640" MinWidth="640" MinHeight="480" ResizeMode="CanResize"
        Icon="pack://application:,,,/Assets/app.ico">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <wv2:WebView2 x:Name="Web" />
        <TextBlock x:Name="Fallback" Grid.Row="0" Style="{StaticResource Text.Subtitle}" TextAlignment="Center" VerticalAlignment="Center" Margin="40" Visibility="Collapsed"
                   Text="The map needs the Microsoft Edge WebView2 runtime (built into Windows 11; free download from Microsoft for Windows 10). Until then, type latitude/longitude in the shop editor." />
        <Border Grid.Row="1" Background="{DynamicResource Brush.Window.Background}" BorderBrush="{DynamicResource Brush.Sidebar.Border}" BorderThickness="0,1,0,0" Padding="16,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource Button.Secondary}" Content="Cancel" Click="OnCancel" MinWidth="90" Margin="0,0,8,0" IsCancel="True" />
                    <Button x:Name="UseBtn" Style="{StaticResource Button.Primary}" Content="Use this location" Click="OnUse" MinWidth="150" IsEnabled="False" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Radius" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox x:Name="RadiusBox" Width="110" SelectionChanged="OnRadiusChanged" />
                    <TextBlock x:Name="Coords" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="16,0,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
