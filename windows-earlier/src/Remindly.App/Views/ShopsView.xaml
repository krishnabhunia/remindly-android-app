<UserControl x:Class="Remindly.App.Views.ShopsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Remindly.App.ViewModels"
             xmlns:m="clr-namespace:Remindly.Core.Models;assembly=Remindly.Core"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:ShopsViewModel}">
    <Grid Margin="24,18,24,0">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>

        <DockPanel Grid.ColumnSpan="2" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBox Style="{StaticResource TextBox.Search}" Width="200" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Tag="Search shops" />
                <Button Style="{StaticResource Button.Secondary}" Content="＋ City" Command="{Binding AddCityCommand}" Margin="8,0,0,0" />
                <Button Style="{StaticResource Button.Primary}" Content="＋ Shop" Command="{Binding AddShopCommand}" Margin="6,0,0,0" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Shops" Style="{StaticResource Text.Title}" />
                <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Subtitle}" Margin="0,2,0,0" />
            </StackPanel>
        </DockPanel>
        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{DynamicResource Brush.Warning.Subtle}" CornerRadius="8" Padding="12,8" Margin="0,0,0,10" Visibility="{Binding CatalogueNote, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding CatalogueNote}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Warning}" />
        </Border>

        <!-- Cities → shops -->
        <Grid Grid.Row="2" Grid.Column="0" Margin="0,0,16,0">
            <TextBlock Text="No shops yet. Add one — a geofence set on the phone rings when you arrive; here you can manage everything." Style="{StaticResource Text.Subtitle}" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="420" Margin="0,60,0,0" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
                <ItemsControl ItemsSource="{Binding Cities}" Margin="0,0,0,24">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:CityGroupViewModel}">
                            <Expander Style="{StaticResource Expander.Group}" IsExpanded="{Binding IsExpanded}">
                                <Expander.Header>
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Visibility="{Binding IsReal, Converter={StaticResource BoolToVis}}">
                                            <Button Style="{StaticResource Button.RowAction}" Content="&#xE8AC;" ToolTip="Rename city" Command="{Binding DataContext.RenameCityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                            <Button Style="{StaticResource Button.RowAction}" Content="&#xE74D;" ToolTip="Delete city (shops move to Unassigned)" Command="{Binding DataContext.DeleteCityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        </StackPanel>
                                        <Border DockPanel.Dock="Right" Style="{StaticResource Badge}" Margin="0,0,8,0"><TextBlock Text="{Binding CountLabel}" Style="{StaticResource Badge.Text}" /></Border>
                                        <TextBlock Text="&#xE80F;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </DockPanel>
                                </Expander.Header>
                                <ItemsControl ItemsSource="{Binding Shops}" Margin="0,4,0,6">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ShopRowViewModel}">
                                            <Border Style="{StaticResource Row}">
                                                <Border.InputBindings><MouseBinding MouseAction="LeftDoubleClick" Command="{Binding EditCommand}" /></Border.InputBindings>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE735;" Style="{StaticResource Icon}" FontSize="12" Foreground="{DynamicResource Brush.Warning}" Margin="0,0,6,0" Visibility="{Binding IsDefault, Converter={StaticResource BoolToVis}}" ToolTip="Default shop for new buy items" />
                                                            <TextBlock Text="{Binding Name}" FontSize="14" TextTrimming="CharacterEllipsis" MaxWidth="360" />
                                                            <Border Style="{StaticResource Pill}" Margin="8,0,0,0"><TextBlock Text="{Binding Tag}" Style="{StaticResource Pill.Text}" /></Border>
                                                            <Border Style="{StaticResource Pill}" Background="{StaticResource Brush.Shop.Subtle}" Margin="6,0,0,0" Visibility="{Binding Pending, Converter={StaticResource BoolToVis}}"><TextBlock Text="{Binding Pending}" Style="{StaticResource Pill.Text}" Foreground="{StaticResource Brush.Shop}" /></Border>
                                                        </StackPanel>
                                                        <TextBlock Style="{StaticResource Text.Caption}" Margin="0,2,0,0"><Run Text="{Binding Geo, Mode=OneWay}" /><Run Text="   " /><Run Text="{Binding Arrive, Mode=OneWay}" /></TextBlock>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                                        <Button Style="{StaticResource Button.Secondary}" Content="Buy Now" Padding="10,4" Command="{Binding BuyNowCommand}" ToolTip="Show only this shop's pending items in Buy" Visibility="{Binding Pending, Converter={StaticResource BoolToVis}}" />
                                                        <Button Style="{StaticResource Button.RowAction}" Content="&#xE735;" Command="{Binding MakeDefaultCommand}" ToolTip="Make default" Visibility="{Binding IsDefault, Converter={StaticResource InvBoolToVis}}" />
                                                        <Button Style="{StaticResource Button.RowAction}" Content="&#xE70F;" Command="{Binding EditCommand}" ToolTip="Edit" />
                                                        <Button Style="{StaticResource Button.RowAction}" Content="&#xE74D;" Command="{Binding DeleteCommand}" ToolTip="Delete" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- Chains -->
        <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource Card}" VerticalAlignment="Top" Margin="0,4,0,24">
            <StackPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.Link}" Content="＋ Add" Command="{Binding AddChainCommand}" />
                    <TextBlock Text="Chains" Style="{StaticResource Text.Section}" />
                </DockPanel>
                <TextBlock Text="D-Mart, Reliance Smart Bazaar… A branch is a shop named “Chain – City”." Style="{StaticResource Text.Caption}" Margin="0,4,0,8" />
                <ItemsControl ItemsSource="{Binding Chains}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type m:Chain}">
                            <DockPanel Margin="0,4">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Style="{StaticResource Button.RowAction}" Content="&#xE710;" ToolTip="Add a branch in a city" Command="{Binding DataContext.AddBranchCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    <Button Style="{StaticResource Button.RowAction}" Content="&#xE8AC;" ToolTip="Rename" Command="{Binding DataContext.RenameChainCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    <Button Style="{StaticResource Button.RowAction}" Content="&#xE74D;" ToolTip="Delete" Command="{Binding DataContext.DeleteChainCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                </StackPanel>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="No chains yet." Style="{StaticResource Text.Caption}" Visibility="{Binding Chains.Count, Converter={StaticResource InvBoolToVis}}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
