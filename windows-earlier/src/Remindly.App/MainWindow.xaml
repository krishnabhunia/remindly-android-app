<Window x:Class="Remindly.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Remindly.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="{Binding WindowTitle}"
        Width="1240" Height="820" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Window.Background}"
        FontFamily="{StaticResource Font.Body}" FontSize="13"
        TextElement.Foreground="{DynamicResource Brush.Text.Primary}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True"
        Icon="pack://application:,,,/Assets/app.ico">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False" NonClientFrameEdges="None" />
    </WindowChrome.WindowChrome>

    <Grid Margin="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource MaxMargin}}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══ Title bar ═══ -->
        <Border Grid.Row="0" Grid.ColumnSpan="3" Background="{DynamicResource Brush.TitleBar.Background}" BorderBrush="{DynamicResource Brush.Sidebar.Border}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="236" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/app-256.png" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="Remindly" FontSize="16" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text.Primary}" />
                    <TextBlock Text="for Windows" FontSize="16" FontWeight="Light" Margin="5,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text.Secondary}" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding CurrentTitle}" VerticalAlignment="Center" Margin="24,0,0,0" FontSize="13" Foreground="{DynamicResource Brush.Text.Tertiary}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Border Background="{DynamicResource Brush.Warning.Subtle}" CornerRadius="10" Padding="8,2" Margin="0,0,10,0" VerticalAlignment="Center"
                            Visibility="{Binding AlertsPaused, Converter={StaticResource BoolToVis}}" ToolTip="Alerts are paused or off on this PC — the phone still rings">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74F;" Style="{StaticResource Icon}" FontSize="11" Foreground="{DynamicResource Brush.Warning}" />
                            <TextBlock Text="Alerts paused" FontSize="11" FontWeight="SemiBold" Margin="5,0,0,0" Foreground="{DynamicResource Brush.Warning}" />
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource Button.Caption}" Content="&#xE921;" Click="OnMinimize" ToolTip="Minimize" />
                    <Button x:Name="MaxRestoreButton" Style="{StaticResource Button.Caption}" Content="&#xE922;" Click="OnMaximizeRestore" ToolTip="Maximize" />
                    <Button Style="{StaticResource Button.Caption.Close}" Content="&#xE8BB;" Click="OnClose" ToolTip="Close (keeps running in the tray)" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ Sidebar ═══ -->
        <Border Grid.Row="1" Grid.RowSpan="2" Grid.Column="0" Background="{DynamicResource Brush.Sidebar.Background}" BorderBrush="{DynamicResource Brush.Sidebar.Border}" BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- ☰ Mode -->
                <Border DockPanel.Dock="Top" Margin="12,12,12,4" Background="{DynamicResource Brush.Badge.Background}" CornerRadius="10" Padding="4">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <RadioButton Style="{StaticResource Button.Segment}" GroupName="Mode" Margin="0" IsChecked="{Binding IsTaskMode, Mode=OneWay}" Command="{Binding SwitchModeCommand}" CommandParameter="TASK" HorizontalContentAlignment="Center">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="13" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" /><TextBlock Text="Task mode" Margin="6,0,0,0" /></StackPanel>
                        </RadioButton>
                        <RadioButton Grid.Column="1" Style="{StaticResource Button.Segment}" GroupName="Mode" Margin="4,0,0,0" IsChecked="{Binding IsShopMode, Mode=OneWay}" Command="{Binding SwitchModeCommand}" CommandParameter="SHOP" HorizontalContentAlignment="Center">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7BF;" Style="{StaticResource Icon}" FontSize="13" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" /><TextBlock Text="Shop mode" Margin="6,0,0,0" /></StackPanel>
                        </RadioButton>
                    </Grid>
                </Border>

                <!-- Account / sync footer -->
                <StackPanel DockPanel.Dock="Bottom" Margin="10,8,10,14">
                    <Border Style="{StaticResource Divider}" Margin="6,0,6,10" />
                    <Button Style="{StaticResource Button.Ghost}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Command="{Binding TogglePersonalCommand}" Padding="10,6"
                            ToolTip="Personal items are hidden behind a PIN on this PC">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="14" Foreground="{DynamicResource Brush.Text.Secondary}">
                                <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Icon}"><Setter Property="Text" Value="&#xE72E;" /><Style.Triggers><DataTrigger Binding="{Binding PersonalUnlocked}" Value="True"><Setter Property="Text" Value="&#xE785;" /><Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                            <TextBlock Margin="8,0,0,0" Foreground="{DynamicResource Brush.Text.Secondary}">
                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="Personal items locked" /><Style.Triggers><DataTrigger Binding="{Binding PersonalUnlocked}" Value="True"><Setter Property="Text" Value="Personal items shown · lock" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Button.Ghost}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Command="{Binding SignInCommand}" Padding="10,6" Margin="0,2,0,0"
                            Visibility="{Binding IsSignedIn, Converter={StaticResource InvBoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8FA;" Style="{StaticResource Icon}" FontSize="14" Foreground="{DynamicResource Brush.Accent}" />
                            <TextBlock Text="Sign in with Google" Margin="8,0,0,0" Foreground="{DynamicResource Brush.Accent}" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                    <StackPanel Margin="10,6,0,0" Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding AccountLine}" FontSize="12" Foreground="{DynamicResource Brush.Text.Secondary}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="10,4,0,0">
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,7,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource Brush.Text.Tertiary}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SyncStatus}" Value="Live"><Setter Property="Fill" Value="{DynamicResource Brush.Success}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding SyncStatus}" Value="Connecting…"><Setter Property="Fill" Value="{DynamicResource Brush.Warning}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding SyncStatus}" Value="Sync error"><Setter Property="Fill" Value="{DynamicResource Brush.Danger}" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding SyncStatus}" FontSize="12" Foreground="{DynamicResource Brush.Text.Secondary}" />
                    </StackPanel>
                    <TextBlock Text="{Binding SyncDetail}" FontSize="11" Margin="10,2,0,0" Foreground="{DynamicResource Brush.Warning}" TextWrapping="Wrap" Visibility="{Binding SyncDetail, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding VersionText}" FontSize="11" Foreground="{DynamicResource Brush.Text.Tertiary}" Margin="10,8,0,0" />
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding NavItems}" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:NavItemViewModel}">
                                <RadioButton Style="{StaticResource Button.Nav}" GroupName="MainNav" Content="{Binding Title}" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ═══ Content ═══ -->
        <ContentControl Grid.Row="1" Grid.Column="1" Content="{Binding CurrentPage}" Focusable="False" />

        <!-- ═══ Editor panel (right) ═══ -->
        <Border Grid.Row="1" Grid.RowSpan="2" Grid.Column="2" Width="420" Background="{DynamicResource Brush.Sidebar.Background}" BorderBrush="{DynamicResource Brush.Sidebar.Border}" BorderThickness="1,0,0,0"
                Visibility="{Binding Editor, Converter={StaticResource BoolToVis}}">
            <ContentControl Content="{Binding Editor}" Focusable="False" />
        </Border>

        <!-- ═══ Ack bar ═══ -->
        <Border Grid.Row="2" Grid.Column="1" Background="#2D2D3A" CornerRadius="8" Padding="14,8" Margin="20,0,20,14" HorizontalAlignment="Center"
                Visibility="{Binding AckText, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding AckText}" Foreground="White" VerticalAlignment="Center" />
                <Button Style="{StaticResource Button.Link}" Content="Undo" Foreground="#8FB3FF" FontWeight="SemiBold" Margin="16,0,0,0" Command="{Binding AckUndoCommand}" />
                <Button Style="{StaticResource Button.Link}" Content="&#xE8BB;" FontFamily="{StaticResource Font.Icons}" FontSize="10" Foreground="#AAAAAA" Margin="12,0,0,0" Command="{Binding AckDismissCommand}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
