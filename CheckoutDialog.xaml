<Window x:Class="Remindly.App.Views.CheckoutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Remindly.App.ViewModels"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:CheckoutViewModel}"
        Style="{StaticResource Window.Dialog}" WindowStartupLocation="CenterOwner"
        Title="Checkout" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        Icon="pack://application:,,,/Assets/app.ico">
    <StackPanel Margin="24">
        <TextBlock Style="{StaticResource Text.Title}"><Run Text="Bought: " /><Run Text="{Binding Item.Title, Mode=OneWay}" /></TextBlock>
        <TextBlock Text="Record where and what you paid — the cheapest-shop suggestions learn from it. Any two of unit price · quantity · cost are enough." Style="{StaticResource Text.Subtitle}" Margin="0,4,0,0" />
        <TextBlock Text="{Binding LastHint}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0" Visibility="{Binding LastHint, Converter={StaticResource BoolToVis}}" />
        <TextBlock Text="SHOP" Style="{StaticResource Text.Field}" />
        <ComboBox IsEditable="True" ItemsSource="{Binding ShopOptions}" Text="{Binding Shop, UpdateSourceTrigger=PropertyChanged}" />
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="UNIT PRICE ₹" Style="{StaticResource Text.Field}" /><TextBox Style="{StaticResource TextBox.Base}" Text="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="QUANTITY" Style="{StaticResource Text.Field}" /><TextBox Style="{StaticResource TextBox.Base}" Text="{Binding Qty, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
            <StackPanel Grid.Column="4"><TextBlock Text="UNIT" Style="{StaticResource Text.Field}" /><ComboBox IsEditable="True" ItemsSource="{Binding Units}" Text="{Binding Unit, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
            <StackPanel Grid.Column="6"><TextBlock Text="COST (MRP) ₹" Style="{StaticResource Text.Field}" /><TextBox Style="{StaticResource TextBox.Base}" Text="{Binding Cost, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
        </Grid>
        <TextBlock Text="PAID ₹ (after discount, optional)" Style="{StaticResource Text.Field}" />
        <TextBox Style="{StaticResource TextBox.Base}" Text="{Binding Paid, UpdateSourceTrigger=PropertyChanged}" Width="160" HorizontalAlignment="Left" />
        <Border Style="{StaticResource Card}" Padding="12,8" Margin="0,12,0,0"><TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" /></Border>
        <Grid Margin="0,18,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Button Style="{StaticResource Button.Ghost}" Content="Skip — just complete" Click="OnSkip" MinHeight="44" Margin="0,0,8,0" />
            <Button Grid.Column="1" Style="{StaticResource Button.Secondary}" Content="Cancel" Click="OnCancel" MinHeight="44" Margin="0,0,4,0" IsCancel="True" />
            <Button Grid.Column="2" Style="{StaticResource Button.Primary}" Content="Record &amp; complete" Click="OnComplete" MinHeight="44" Margin="4,0,0,0" IsDefault="True" />
        </Grid>
    </StackPanel>
</Window>
