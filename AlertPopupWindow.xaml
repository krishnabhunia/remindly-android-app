<Window x:Class="Remindly.App.Views.AlertPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="380" SizeToContent="Height" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize" ShowActivated="False"
        FontFamily="{StaticResource Font.Body}" FontSize="13" TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <Border Background="{DynamicResource Brush.Card.Background}" BorderBrush="{DynamicResource Brush.Card.Border}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="8">
        <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.25" /></Border.Effect>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Ghost}" Content="&#xE8BB;" FontFamily="{StaticResource Font.Icons}" FontSize="10" Padding="6,4" Click="OnClose" ToolTip="Dismiss" VerticalAlignment="Top" />
                <StackPanel Orientation="Horizontal">
                    <Border x:Name="Badge" Background="{DynamicResource Brush.Accent.Subtle}" CornerRadius="8" Width="32" Height="32" Margin="0,0,10,0">
                        <TextBlock x:Name="Glyph" Text="🔔" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="Kicker" Text="Remindly · Tasks" Style="{StaticResource Text.Label}" />
                        <TextBlock x:Name="TitleText" Text="Title" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}" TextWrapping="Wrap" MaxWidth="270" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
            <TextBlock x:Name="Sub" Grid.Row="1" Style="{StaticResource Text.Caption}" Margin="42,4,0,0" TextWrapping="Wrap" />
            <ItemsControl x:Name="List" Grid.Row="2" Margin="42,6,0,0" Visibility="Collapsed">
                <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Text.Primary}" /></DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <WrapPanel x:Name="Actions" Grid.Row="3" Margin="42,12,0,0">
                <Button x:Name="DoneBtn" Style="{StaticResource Button.Primary}" Content="Done" Click="OnDone" Padding="12,5" Margin="0,0,6,0" />
                <Button x:Name="SnoozeBtn" Style="{StaticResource Button.Secondary}" Content="Snooze" Click="OnSnooze" Padding="12,5" Margin="0,0,6,0" />
                <Button x:Name="QuietBtn" Style="{StaticResource Button.Secondary}" Content="Quiet" Click="OnQuiet" Padding="12,5" Margin="0,0,6,0" ToolTip="Silence now; back later as a Notification (permanent for this item)" />
                <Button x:Name="StopBtn" Style="{StaticResource Button.Secondary}" Content="Stop sound" Click="OnStop" Padding="12,5" Margin="0,0,6,0" Visibility="Collapsed" />
                <Button x:Name="OpenBtn" Style="{StaticResource Button.Ghost}" Content="Open" Click="OnOpen" Padding="12,5" />
            </WrapPanel>
        </Grid>
    </Border>
</Window>
